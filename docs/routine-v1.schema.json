{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Routine Builder routine file, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "routine"],
  "properties": {
    "format": { "const": "routine-builder.routine" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "routine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "tasks"],
      "properties": {
        "title": { "$ref": "#/$defs/title" },
        "tasks": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/task" }
        }
      }
    }
  },
  "$defs": {
    "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "title", "icon", "category", "kind", "instructions", "durationMinutes", "timeOfDay", "daysOfWeek", "isDurationTask"],
      "properties": {
        "templateId": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/title" },
        "icon": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "\\S" },
        "category": { "enum": ["Exercise", "Learning", "Wellbeing", "Daily Essentials"] },
        "kind": { "$ref": "#/$defs/identifier" },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" },
        "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 999 },
        "timeOfDay": { "type": "string", "minLength": 5, "maxLength": 5, "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "daysOfWeek": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 7 }
        },
        "isDurationTask": { "type": "boolean" }
      }
    }
  }
}
