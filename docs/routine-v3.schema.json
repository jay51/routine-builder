{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Routine Builder routine file, version 3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "routine"
  ],
  "properties": {
    "format": {
      "const": "routine-builder.routine"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 3
    },
    "routine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "tasks"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/title"
        },
        "tasks": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      }
    }
  },
  "$defs": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateId",
        "title",
        "icon",
        "category",
        "kind",
        "instructions",
        "durationMinutes",
        "timeOfDay",
        "daysOfWeek",
        "isDurationTask",
        "timerEnabled",
        "timerMinutes",
        "checklistEnabled",
        "checklistItems"
      ],
      "properties": {
        "templateId": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "\\S"
        },
        "category": {
          "enum": [
            "Exercise",
            "Learning",
            "Wellbeing",
            "Daily Essentials"
          ]
        },
        "kind": {
          "$ref": "#/$defs/identifier"
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "timeOfDay": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "daysOfWeek": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        },
        "isDurationTask": {
          "type": "boolean"
        },
        "timerEnabled": {
          "type": "boolean"
        },
        "timerMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "checklistEnabled": {
          "type": "boolean"
        },
        "checklistItems": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "timerEnabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "isDurationTask": {
                "const": true
              },
              "kind": {
                "enum": [
                  "run",
                  "walk",
                  "strength",
                  "stretch",
                  "yoga",
                  "study",
                  "read",
                  "review",
                  "language",
                  "meditate",
                  "journal",
                  "breathe",
                  "outside",
                  "tidy"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "checklistEnabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "checklistItems": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
